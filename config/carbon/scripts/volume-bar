#!/usr/bin/env python3
"""Volume as a Carbon progress line: filled cells in interactive blue, track in layer 02."""
import json,subprocess
CELLS=10
try:
 v=int(subprocess.check_output(['pamixer','--get-volume'],text=True));mute=subprocess.check_output(['pamixer','--get-mute'],text=True).strip()=='true'
 full=min(CELLS,max(0,round(v*CELLS/100)))
 if mute:text='vol <span foreground="#393939">'+'━'*CELLS+'</span> <span foreground="#6f6f6f">mudo</span>'
 else:text='vol <span foreground="#78a9ff">'+'━'*full+'</span><span foreground="#393939">'+'━'*(CELLS-full)+f'</span> <span foreground="#f2f4f8">{v}</span>'
 print(json.dumps({'text':text,'class':'muted' if mute else 'active','tooltip':'Volume · role para ajustar · clique para silenciar'}))
except (OSError,ValueError,subprocess.SubprocessError):print(json.dumps({'text':'vol —','class':'unavailable'}))
