{
  // Carbon UI Shell header: full width, flush to the top edge, 1px rule below.
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "height": 32,
  "spacing": 0,
  "modules-left": [
    "custom/dashboard",
    "custom/ws#w1",
    "custom/ws#w2",
    "custom/ws#w3",
    "custom/ws#w4",
    "custom/ws#w5",
    "hyprland/window"
  ],
  "modules-center": [],
  "modules-right": [
    "mpris",
    "cpu",
    "memory",
    "custom/volume",
    "network",
    "custom/tailnet",
    "custom/notifications",
    "custom/clock"
  ],
  "custom/dashboard": {
    "format": "carbon <span weight=\"400\">workstation</span>",
    "on-click": "~/.config/carbon/control dashboard",
    "tooltip-format": "Painel · Super + Tab"
  },
  // Workspace buttons: Waybar's hyprland/workspaces sends the legacy dispatch, which the Lua config rejects.
  "custom/ws#w1": {
    "exec": "~/.config/carbon/scripts/ws 1",
    "return-type": "json",
    "signal": 8,
    "interval": "once",
    "on-click": "~/.config/carbon/scripts/ws 1 --go"
  },
  "custom/ws#w2": {
    "exec": "~/.config/carbon/scripts/ws 2",
    "return-type": "json",
    "signal": 8,
    "interval": "once",
    "on-click": "~/.config/carbon/scripts/ws 2 --go"
  },
  "custom/ws#w3": {
    "exec": "~/.config/carbon/scripts/ws 3",
    "return-type": "json",
    "signal": 8,
    "interval": "once",
    "on-click": "~/.config/carbon/scripts/ws 3 --go"
  },
  "custom/ws#w4": {
    "exec": "~/.config/carbon/scripts/ws 4",
    "return-type": "json",
    "signal": 8,
    "interval": "once",
    "on-click": "~/.config/carbon/scripts/ws 4 --go"
  },
  "custom/ws#w5": {
    "exec": "~/.config/carbon/scripts/ws 5",
    "return-type": "json",
    "signal": 8,
    "interval": "once",
    "on-click": "~/.config/carbon/scripts/ws 5 --go"
  },
  "hyprland/window": {
    "format": "<span foreground=\"#6f6f6f\">/</span>  {}",
    "max-length": 64,
    "separate-outputs": true
  },
  "cpu": {
    "format": "cpu <span foreground=\"#f2f4f8\">{usage}%</span>",
    "interval": 3,
    "states": { "warning": 70, "critical": 90 }
  },
  "memory": {
    "format": "mem <span foreground=\"#f2f4f8\">{used:.1f}G</span>",
    "interval": 5,
    "states": { "warning": 80, "critical": 92 }
  },
  "custom/volume": {
    "exec": "~/.config/carbon/scripts/volume-bar",
    "return-type": "json",
    "interval": 1,
    "on-click": "~/.config/carbon/control volume --toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "~/.config/carbon/control volume --inc",
    "on-scroll-down": "~/.config/carbon/control volume --dec"
  },
  "network": {
    "format-ethernet": "<span foreground=\"#42be65\">■</span> {ifname}",
    "format-wifi": "<span foreground=\"#42be65\">■</span> {essid}",
    "format-disconnected": "<span foreground=\"#ee5396\">■</span> offline",
    "max-length": 22,
    "on-click": "nm-connection-editor",
    "tooltip-format": "{ifname} · {ipaddr}"
  },
  "custom/tailnet": {
    "exec": "~/.config/carbon/scripts/tailnet",
    "return-type": "json",
    "interval": 10,
    "signal": 9,
    "on-click": "~/.config/carbon/scripts/tailnet --toggle"
  },
  "mpris": {
    "format": "<span foreground=\"#be95ff\">▶</span> {title}",
    "format-paused": "<span foreground=\"#6f6f6f\">❚❚</span> {title}",
    "max-length": 30,
    "on-click": "playerctl play-pause",
    "tooltip-format": "{artist} — {title}"
  },
  "custom/notifications": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "format": "{icon} avisos {text}",
    "format-icons": {
      "notification": "■", "none": "□",
      "dnd-notification": "■", "dnd-none": "□",
      "inhibited-notification": "■", "inhibited-none": "□",
      "dnd-inhibited-notification": "■", "dnd-inhibited-none": "□"
    },
    "on-click": "swaync-client -t",
    "on-click-right": "swaync-client -d",
    "tooltip": false
  },
  "custom/clock": {
    "exec": "~/.config/carbon/scripts/clock",
    "return-type": "json",
    "interval": 1,
    "on-click": "~/.config/carbon/control dashboard"
  }
}
